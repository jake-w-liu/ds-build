{
  "threshold": 3,
  "minLines": 8,
  "minTokens": 50,
  "maxLines": 3000,
  "gitignore": true,
  "absolute": false,
  "reporters": ["console", "json"],
  "output": "./.jscpd",
  "ignore": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/target/**",
    "**/coverage/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*_pb2.py",
    "**/*.pb.go",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/*.generated.*",
    "**/*_generated.*",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/migrations/**",
    "**/*.lock",
    "**/*-lock.json"
  ],
  "format": [
    "python",
    "javascript",
    "jsx",
    "typescript",
    "tsx",
    "julia",
    "rust",
    "go",
    "java",
    "kotlin",
    "swift",
    "c",
    "c++",
    "c#",
    "ruby",
    "php",
    "sql"
  ]
}
